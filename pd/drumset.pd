#N canvas 30 30 1150 780 12;
#X obj 30 40 netreceive -u -b 8000;
#X obj 30 70 oscparse;
#X obj 30 100 route /drum/hit;
#X obj 30 130 unpack s f f f f;
#X obj 260 160 s hit-x;
#X obj 320 160 s hit-y;
#X obj 380 160 s hit-z;
#X obj 30 160 pack s f;
#X obj 30 190 route bassdrum snare hitom medtom floortom hihat crash ride;
#X obj 30 220 s fire-bassdrum;
#X obj 130 220 s fire-snare;
#X obj 230 220 s fire-hitom;
#X obj 330 220 s fire-medtom;
#X obj 430 220 s fire-floortom;
#X obj 530 220 s fire-hihat;
#X obj 630 220 s fire-crash;
#X obj 730 220 s fire-ride;
#X obj 30 290 voice-multi bassdrum;
#X obj 200 290 voice-multi snare;
#X obj 370 290 voice-multi hihat;
#X obj 30 340 voice-single hitom;
#X obj 170 340 voice-single medtom;
#X obj 310 340 voice-single floortom;
#X obj 450 340 voice-single crash;
#X obj 590 340 voice-single ride;
#X obj 800 290 table bassdrum-soft 100;
#X obj 800 310 table bassdrum-med 100;
#X obj 800 330 table bassdrum-hard 100;
#X obj 800 350 table snare-soft 100;
#X obj 800 370 table snare-med 100;
#X obj 800 390 table snare-hard 100;
#X obj 800 410 table hihat-soft 100;
#X obj 800 430 table hihat-med 100;
#X obj 800 450 table hihat-hard 100;
#X obj 800 480 table hitom 100;
#X obj 800 500 table medtom 100;
#X obj 800 520 table floortom 100;
#X obj 800 540 table crash 100;
#X obj 800 560 table ride 100;
#X obj 30 430 loadbang;
#X msg 30 460 read -resize samples/bassdrum-soft.wav bassdrum-soft \, read -resize samples/bassdrum-med.wav bassdrum-med \, read -resize samples/bassdrum-hard.wav bassdrum-hard \, read -resize samples/snare-soft.wav snare-soft \, read -resize samples/snare-med.wav snare-med \, read -resize samples/snare-hard.wav snare-hard \, read -resize samples/hihat-soft.wav hihat-soft \, read -resize samples/hihat-med.wav hihat-med \, read -resize samples/hihat-hard.wav hihat-hard \, read -resize samples/hitom.wav hitom \, read -resize samples/medtom.wav medtom \, read -resize samples/floortom.wav floortom \, read -resize samples/crash.wav crash \, read -resize samples/ride.wav ride;
#X obj 30 550 soundfiler;
#X obj 30 620 catch~ mix-L;
#X obj 120 620 catch~ mix-R;
#X obj 30 650 *~ 0.8;
#X obj 120 650 *~ 0.8;
#X obj 30 680 clip~ -0.98 0.98;
#X obj 120 680 clip~ -0.98 0.98;
#X obj 30 720 dac~ 1 2;
#X text 30 10 === OSC Input === UDP 8000 \, routes by instrument name \, publishes velocity via [s fire-NAME];
#X text 30 260 === Voices === bass/snare/hihat use 3-layer velocity crossfade \; toms/crash/ride are single-sample velocity-scaled;
#X text 800 270 === Sample Tables === (resized on load);
#X text 30 400 === Loader === fires 14 read messages at startup;
#X text 30 590 === Master Bus === soft-limit \, stereo dac~;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 7 0;
#X connect 3 1 7 1;
#X connect 3 2 4 0;
#X connect 3 3 5 0;
#X connect 3 4 6 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 8 1 10 0;
#X connect 8 2 11 0;
#X connect 8 3 12 0;
#X connect 8 4 13 0;
#X connect 8 5 14 0;
#X connect 8 6 15 0;
#X connect 8 7 16 0;
#X connect 39 0 40 0;
#X connect 40 0 41 0;
#X connect 42 0 44 0;
#X connect 43 0 45 0;
#X connect 44 0 46 0;
#X connect 45 0 47 0;
#X connect 46 0 48 0;
#X connect 47 0 48 1;
