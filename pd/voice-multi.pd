#N canvas 60 60 620 380 12;
#X obj 30 30 r fire-\$1;
#X obj 30 60 t f f f;
#X obj 30 100 t b f;
#X obj 90 130 expr max(0\, 1 - 2*\$f1);
#X obj 30 160 tabplay~ \$1-soft;
#X obj 30 200 *~ 1;
#X obj 200 100 t b f;
#X obj 260 130 expr min(2*\$f1\, 2*(1 - \$f1));
#X obj 200 160 tabplay~ \$1-med;
#X obj 200 200 *~ 1;
#X obj 370 100 t b f;
#X obj 430 130 expr max(0\, 2*\$f1 - 1);
#X obj 370 160 tabplay~ \$1-hard;
#X obj 370 200 *~ 1;
#X obj 30 240 +~;
#X obj 30 270 +~;
#X obj 30 300 *~ 0.9;
#X obj 30 330 throw~ mix-L;
#X obj 100 330 throw~ mix-R;
#X text 30 10 voice-multi \$1 -- 3-layer velocity crossfade;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 1 1 6 0;
#X connect 1 2 10 0;
#X connect 2 0 4 0;
#X connect 2 1 3 0;
#X connect 3 0 5 1;
#X connect 4 0 5 0;
#X connect 6 0 8 0;
#X connect 6 1 7 0;
#X connect 7 0 9 1;
#X connect 8 0 9 0;
#X connect 10 0 12 0;
#X connect 10 1 11 0;
#X connect 11 0 13 1;
#X connect 12 0 13 0;
#X connect 5 0 14 0;
#X connect 9 0 14 1;
#X connect 14 0 15 0;
#X connect 13 0 15 1;
#X connect 15 0 16 0;
#X connect 16 0 17 0;
#X connect 16 0 18 0;
